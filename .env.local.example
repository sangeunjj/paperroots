# Claude API 키 — https://console.anthropic.com 에서 발급
# 이 파일을 복사해 ".env.local" 로 만들고 실제 키를 채워 넣으세요.
ANTHROPIC_API_KEY=sk-ant-여기에_본인_키

# (선택) 사용할 Claude 모델. 기본값은 claude-opus-4-8 (최고 품질).
# 비용을 줄이려면 claude-haiku-4-5 로 바꾸세요 (약 1/5 비용).
CLAUDE_MODEL=claude-opus-4-8

# (선택) OpenAlex 정중한 요청을 위한 이메일 (rate-limit 우대). 학교 이메일 권장.
OPENALEX_MAILTO=jse1769@korea.ac.kr
